# Postgres (docker compose up -d starts this)
DATABASE_URL=postgres://stack:stack@localhost:55432/daily_stack

# Timezone the daily edition is cut in, and the hour it freezes.
EDITION_TZ=Asia/Kolkata
EDITION_FREEZE_HOUR=6

# Enrichment. Without a key, editions build with raw titles and no summaries.
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-haiku-5-5

# Optional: lifts GitHub rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=

# Optional: enables the Reddit source (script-type app credentials).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Protects /api/cron.
CRON_SECRET=

# Raw items are pruned past this age. Published editions are frozen copies and
# are never affected. 45 days keeps a free 0.5GB Postgres at roughly 120MB.
RETENTION_DAYS=45
