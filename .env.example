# Postgres (docker compose up -d starts this)
DATABASE_URL=postgres://stack:stack@localhost:55432/daily_stack

# Timezone the daily edition is cut in, and the hour it freezes.
EDITION_TZ=Asia/Kolkata
EDITION_FREEZE_HOUR=6

# Enrichment. Without a key, editions build with raw titles and no summaries.
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-haiku-5-5

# The Weekly Shelf: one book a week, published Friday night in EDITION_TZ.
# Without ANTHROPIC_API_KEY the shelf cannot be written at all - unlike an
# edition, there is no non-model fallback for four thousand words.
SHELF_MODEL=claude-opus-5-5
SHELF_PUBLISH_HOUR=21
SHELF_MAX_SEARCHES=14

# Fallback writer, used only when no piece is committed in db/seed/shelf and
# ANTHROPIC_API_KEY is empty. google_search carries a free monthly allowance;
# if this key cannot search, links are probed for existence instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: lifts GitHub rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=

# Optional: enables the Reddit source (script-type app credentials).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Protects /api/cron.
CRON_SECRET=

# Raw items are pruned past this age. Published editions are frozen copies and
# are never affected. 45 days keeps a free 0.5GB Postgres at roughly 120MB.
RETENTION_DAYS=45
